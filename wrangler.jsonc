{
  "name": "school-shell-setup",
  "main": "site/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "routes": [{ "pattern": "setup.toni.foo", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  "observability": { "enabled": true }
}
